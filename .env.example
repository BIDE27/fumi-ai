# ==============================================================================
# VARIABLES D'ENVIRONNEMENT OFFICIELLES - FUMI AI SOUVERAIN
# ==============================================================================

# 1. Fournisseurs d'Intelligence Artificielle
# Google Gemini 2.5 Flash / Pro (Clé gratuite sur aistudio.google.com)
GEMINI_API_KEY=votre_cle_gemini_ici
GOOGLE_API_KEY=votre_cle_gemini_ici

# Groq Cloud (Inférence Open-Source Qwen 2.5, DeepSeek-R1, Llama 3.3 - console.groq.com)
GROQ_API_KEY=gsk_votre_cle_groq_ici

# 2. Clé Maître API Fumi pour les applications externes (comme Fa & Vodun Connect)
# Format standard : fumi_sk_live_... ou fumi_sk_test_...
FUMI_MASTER_API_KEY=fumi_sk_live_africa_sovereign_ai_2026

# 3. Base de Données Supabase (Optionnel pour persistance cloud des sessions & messages)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_ici
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete_ici

# 4. Sécurité & Limitation de Débit (Zero-Trust)
AI_DAILY_QUOTA=1000
AI_IP_SALT=fumi-sovereign-ai-security-salt
